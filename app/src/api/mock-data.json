  "questions": [
    {
      "id": "q-ml-rf",
      "skillId": "ml",
      "prompt": "Why does a random forest usually generalize better than a single deep decision tree?",
      "options": [
        {
          "id": "A",
          "text": "It uses fewer features."
        },
        {
          "id": "B",
          "text": "Averaging many trees trained on bootstrapped samples and random feature subsets lowers variance."
        },
        {
          "id": "C",
          "text": "Each tree is deeper."
        },
        {
          "id": "D",
          "text": "It fits the training data more exactly.",
          "misconception": "A forest usually fits training data slightly less exactly than one unpruned tree. The gain comes from averaging."
        }
      ],
      "correctId": "B",
      "explanation": "Single deep trees have high variance. Averaging many trees makes their errors less correlated, so the average is more stable.",
      "nextReviewIfRight": "Next review in 20 days.",
      "nextReviewIfWrong": "You'll see this again tomorrow."
    },
    {
      "id": "q-t04-01",
      "skillId": "inference",
      "prompt": "A 95 percent confidence interval (the classical, frequentist kind) for a mean is [4.1, 5.3]. Which statement is correct?",
      "options": [
        {
          "id": "A",
          "text": "95 percent of individual observations fall between 4.1 and 5.3.",
          "misconception": "Confuses an interval for the mean with a range for individual values."
        },
        {
          "id": "B",
          "text": "If the study were repeated many times, about 95 percent of the intervals built this way would contain the true mean."
        },
        {
          "id": "C",
          "text": "Given this one interval, the probability is 0.95 that the true mean lies inside it.",
          "misconception": "Treats the fixed true mean as random; that reading belongs to a Bayesian credible interval."
        },
        {
          "id": "D",
          "text": "The sample mean is between 4.1 and 5.3 with probability 0.95.",
          "misconception": "The sample mean is a known number that sits at the interval's center."
        }
      ],
      "correctId": "B",
      "explanation": "The 95 percent describes the long-run behavior of the procedure across repeated samples. Any single interval either contains the true mean or does not.",
      "nextReviewIfRight": "Next review in 14 days.",
      "nextReviewIfWrong": "You'll see this again tomorrow."
    },
    {
      "id": "q-t10-02",
      "skillId": "communicating",
      "prompt": "A stakeholder asks: 'So is the effect real or not?' Your interval is [-0.1, 1.2] points. The best answer is:",
      "options": [
        {
          "id": "A",
          "text": "No, it is not significant, so there is no effect.",
          "misconception": "Non-significant is not 'no effect'."
        },
        {
          "id": "B",
          "text": "The best estimate is a lift of about 0.5 points, and the data are consistent with anything from a slight loss to a 1.2-point gain. If a wrong call is cheap, ship and monitor; if it is costly, run the test longer."
        },
        {
          "id": "C",
          "text": "Yes, the effect is 0.5 points.",
          "misconception": "Drops the uncertainty the stakeholder needs."
        },
        {
          "id": "D",
          "text": "Statistics cannot answer that.",
          "misconception": "Statistics does answer it, with a range and a recommendation."
        }
      ],
      "correctId": "B",
      "explanation": "Translate the interval into the decision's terms: the point estimate, the range, and what the uncertainty means for the choice in front of them.",
      "nextReviewIfRight": "Next review in 14 days.",
      "nextReviewIfWrong": "You'll see this again tomorrow."
    }
  ],
