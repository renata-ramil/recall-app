        {
          "value": "0.08",
          "label": "p-value"
        }
      ],
      "steps": [
        {
          "type": "choice",
          "prompt": "What do you tell her?",
          "options": [
            {
              "id": "a",
              "text": "Ship it. The new page won."
            },
            {
              "id": "b",
              "text": "Do not ship. The test failed."
            },
            {
              "id": "c",
              "text": "The result is inconclusive at the 5% level. The lift could be anywhere from slightly negative to about 1 point. Extend the test, or decide based on the cost of a wrong call."
            },
            {
              "id": "d",
              "text": "Rerun until p drops below 0.05."
            }
          ],
          "correctId": "c"
        },
        {
          "type": "choice",
          "prompt": "Nobody knows yet what a wrong call would cost. What should happen next?",
          "options": [
            {
              "id": "a",
              "text": "Extend the test for a fixed two more weeks, set now, then decide."
            },
            {
              "id": "b",
              "text": "Ship now, and roll back if conversion drops over the next week."
            },
            {
              "id": "c",
              "text": "Keep the old page and close the test."
            },
            {
              "id": "d",
              "text": "Rerun the analysis with a one-sided test to get p under 0.05."
