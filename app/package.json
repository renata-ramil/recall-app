{
  "name": "recall",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:pilot": "tsc -b && VITE_PILOT=1 vite build --base /recall-app/pilot/ --outDir ../docs/pilot --emptyOutDir",
    "build:all": "npm run build && npm run build:pilot && node scripts/make404.mjs",
    "dev:pilot": "VITE_PILOT=1 vite"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "playwright": "1.49.1"
  }
}
